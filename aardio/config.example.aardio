// SysIns 自动安装工具 - Aardio 配置模板
// 使用方法：复制本文件为 config.aardio，然后填写实际配置
// 注意：config.aardio 已被 .gitignore 排除，不会上传到 GitHub

CFG = {
    phone = "your_phone_number";
    uuycDir = "D:\SoftApp\GameViewer";
    imapHost = "imap.zoho.com.cn";
    imapPort = 993;
    imapUser = "your_email@example.com";
    imapPwd = "your_imap_password";
    subjectKw = "验证码邮件通知";
    record = true;
    awsunPwd = "your_awesun_password";
    smtpHost = "smtp.qq.com";
    smtpPort = 465;
    smtpUser = "your_email@qq.com";
    smtpPwd = "your_smtp_authorization_code";
    mailTo = "your_email@example.com";
    lang = "Aardio";
}
