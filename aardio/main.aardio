COPY_AWSUN_INFO = function(main){
    import win.clip;
    FORCE_FG(main);
    var r = win.getRect(main, true);
    var W = r.right-r.left; var H = r.bottom-r.top;
    var PT = function(rx, ry, dx, dy){
        return {x = r.left + W*rx + (dx ?: 0); y = r.top + H*ry + (dy ?: 0)};
    }
    mouse.click(PT(0.090, 0.155));
    sleep(2000);
    SHOT("awsun_info_page");
    win.clip.write("__SYSINS_SENTINEL__");
    sleep(300);
    var SENTINEL = "__SYSINS_SENTINEL__";
    var offs = { {0;0}; {0;-14}; {0;14}; {-16;0}; {16;0} };
    var idClip = null;
    for(k=1; #offs; 1){
        if(idClip) break;
        mouse.click(PT(0.522, 0.305, offs[k][1], offs[k][2]));
        sleep(1500);
        var c = win.clip.read();
        if(c != SENTINEL && c && #c > 0) idClip = c;
    }
    var codeClip = null;
    win.clip.write(SENTINEL);
    sleep(300);
    mouse.click(PT(0.712, 0.294));
    sleep(1500);
    var c = win.clip.read();
    if(c != SENTINEL && c && #c > 0) codeClip = c;
    if(!codeClip){
        for(k=1; #offs; 1){
            if(codeClip) break;
            mouse.click(PT(0.755, 0.300, offs[k][1], offs[k][2]));
            sleep(1500);
            var c = win.clip.read();
            if(c != SENTINEL && c && #c > 0) codeClip = c;
        }
    }
    SHOT("awsun_copied");
    LOG("AweSun 识别码剪贴板:", idClip or "(空)");
    LOG("AweSun 验证码剪贴板:", codeClip or "(空)");
    return idClip, codeClip;
}

UNINSTALL_MATCH = function(name, kind){
	if(!name) return false;
	var low = string.lower(name);
	if(kind == "uu") return string.find(low, "uu远程") || string.find(low, "gameviewer");
	if(kind == "aw") return string.find(name, "向日葵") || string.find(low, "awesun") || string.find(low, "sunlogin");
	if(kind == "hr") return string.find(name, "火绒") || string.find(low, "huorong") || string.find(low, "sysdiag");
	return false;
}

UNINSTALL_UI = function(seconds){
	var tk = time.tick();
	var okTexts = { "继续卸载"; "残忍卸载"; "确定"; "是"; "下一步"; "卸载" };
	while(time.tick()-tk < seconds*1000){
		var acted = false;
		winex.enumTop(function(h){
			if(acted) return;
			if(!win.isVisible(h)) return;
			var t = win.getText(h); var c = win.getClass(h);
			if(c == "#32770" || string.find(c, "OrayUI") || string.find(c, "HUORONG") || string.find(t, "卸载")){
				for(k=1; #okTexts; 1){
					var b = winex.findEx(h, , "Button", okTexts[k]);
					if(b){ LOG("卸载向导点击:", okTexts[k]); FORCE_FG(h); winex.click(b); acted = true; sleep(1500); break; }
				}
			}
		});
		if(!acted) sleep(1500);
	}
}

SYS_REMOVED = false;

UNINSTALL_ALL = function(){
	LOG("================ 卸载阶段 ================");
	import win.reg;
	KILL_STALE();
	var regPaths = {
		"HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall";
		"HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall";
		"HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall";
	};
	var kinds = { "uu"; "aw"; "hr" };
	for(ki=1; #kinds; 1){
		var kind = kinds[ki];
		for(pi=1; #regPaths; 1){
			var parent = win.reg(regPaths[pi], true);
			if(!parent) continue;
			var subNames = parent.keys();
			parent.close();
			for(si=1; #subNames; 1){
				var reg = win.reg(regPaths[pi] .. "\" .. subNames[si], true);
				if(!reg) continue;
				var dn = reg.queryValue("DisplayName");
				if(dn && UNINSTALL_MATCH(dn, kind)){
					LOG("发现已安装:", dn);
					var cmd = reg.queryValue("QuietUninstallString");
					if(!cmd) cmd = reg.queryValue("UninstallString");
					reg.close();
					if(cmd){
						if(string.find(string.lower(cmd), "unins") && !string.find(cmd, "/")) cmd = cmd .. " /S";
						LOG("执行卸载命令:", cmd);
						var pr = process.popen("cmd.exe", {"/c"; cmd});
						pr.waitOne(90000);
						UNINSTALL_UI(60);
						if(kind == "hr"){ SYS_REMOVED = true; LOG("sysdiag 已卸载，重装前必须重启系统"); }
					}
				}
				else reg.close();
			}
		}
	}
	process(, "sc stop SunloginService"); process(, "sc delete SunloginService");
	var svcs = { "HipsDaemon"; "HipsKeeper"; "HipsService" };
	for(k=1; #svcs; 1){ process(, "sc stop " .. svcs[k]); process(, "sc delete " .. svcs[k]); }
	sleep(3000);
	KILL_STALE();
	RMDIR = function(p){
		if(io.exist(p)){
			var pr = process.popen("cmd.exe", {"/c"; 'rmdir /s /q "' .. p .. '"'});
			pr.waitOne(30000);
			LOG("已删除目录:", p);
		}
	}
	RMDIR(CFG.uuycDir); RMDIR("C:\Program Files\Oray"); RMDIR("C:\Program Files\Huorong");
	LOG("卸载阶段完成");
}

console.log("================ SysIns aardio 自动安装 开始 ================");
LOG("根目录:", rootDir);

mode = "all";
if(_ARGV){
	if(_ARGV.resume !== null) mode = "resume";
	elseif(_ARGV.uninstall !== null) mode = "uninstall";
	elseif(_ARGV.sysdiag !== null) mode = "sysdiag";
	elseif(_ARGV.uu !== null) mode = "uu";
	elseif(_ARGV.awesun !== null) mode = "awesun";
}

if(mode == "resume"){
	var pending = CHECK_RESUME();
	if(pending === null){ LOG("无续跑状态，退出"); return }
	if(pending === false){ return }
	mode = pending;
}
elseif(io.exist(RESUME_PATH())){
	var pending = CHECK_RESUME();
	if(pending === false){ return }
	if(pending) mode = pending;
}

if(mode != "uninstall" && mode != "sysdiag"){
	var hrDetected = CHECK_HUORONG();
	if(hrDetected){
		LOG("检测到火绒安全软件正在运行（" .. hrDetected .. "），请先手动退出或卸载后再运行本脚本");
		return 2;
	}
}

START_REC(null, "boot");

if(mode == "uninstall"){
	UNINSTALL_ALL();
	STOP_REC();
	return;
}

if(mode == "sysdiag"){
	UNINSTALL_ALL();
	if(SYS_REMOVED){
		RESUME_TASK("sysdiag2");
		STOP_REC();
		DO_REBOOT();
		sleep(15000);
		return;
	}
	STOP_REC();
	return;
}

if(mode == "uu"){
	var uuOk, mainHwnd = INSTALL_UU();
	if(uuOk){
		SKIP_GUIDE(); sleep(1000);
		var loginOk = true;
		if(IS_UU_LOGINED(mainHwnd)){
			LOG("UU 已登录，跳过登录流程");
		}
		else{
			var login = OPEN_LOGIN(mainHwnd);
			if(login){ loginOk = DO_LOGIN(login, mainHwnd); }
			else{ LOG("错误：登录窗口未打开"); loginOk = false; }
		}
		if(loginOk){ sleep(3000); uuClip = COPY_UU_INFO(mainHwnd); }
	}
	STOP_REC();
	return;
}

if(mode == "awesun"){
	var awMain = INSTALL_AWSUN();
	if(awMain){
		awLoginOk = LOGIN_AWSUN(awMain);
		if(awLoginOk){ awId, awCode = COPY_AWSUN_INFO(awMain); }
	}
	STOP_REC();
	return;
}

if(mode == "phase2" || mode == "sysdiag2"){
	KILL_STALE();
}
else{
	UNINSTALL_ALL();
	if(SYS_REMOVED){
		RESUME_TASK("phase2");
		STOP_REC();
		DO_REBOOT();
		sleep(15000);
		return;
	}
}

var uuOk, mainHwnd = INSTALL_UU();
var loginOk = false;
var uuClip = null;
if(uuOk){
    SKIP_GUIDE();
    sleep(1000);
    if(IS_UU_LOGINED(mainHwnd)){
        LOG("UU 已登录，跳过登录流程");
        loginOk = true;
    }
    else{
        var login = OPEN_LOGIN(mainHwnd);
        if(login){ loginOk = DO_LOGIN(login, mainHwnd); }
        else{ LOG("错误：登录窗口未打开"); loginOk = false; }
    }
    if(loginOk){ sleep(3000); uuClip = COPY_UU_INFO(mainHwnd); }
}
else{ LOG("UU 安装失败，跳过登录步骤"); }

var awMain = INSTALL_AWSUN();
var awLoginOk = false;
var awId, awCode;
if(awMain){
    awLoginOk = LOGIN_AWSUN(awMain);
    if(awLoginOk){ awId, awCode = COPY_AWSUN_INFO(awMain); }
}
else{ LOG("AweSun 安装失败，跳过登录步骤"); }

var uuMailOk = false;
var awMailOk = false;
if(loginOk){
    var body = "网易UU远程已自动安装并登录成功。\r\n识别码信息: " .. (uuClip or "(未复制到)") .. "\r\n截图见附件。";
    uuMailOk = SEND_MAIL("网易UU远程", body, logDir .. "\uu_after_copy.png") === true;
}
if(awLoginOk){
    var body = "AweSun向日葵已自动安装并登录成功。\r\n识别码: " .. (awId or "(未复制到)") .. "\r\n验证码: " .. (awCode or "(未复制到)") .. "\r\n截图见附件。";
    awMailOk = SEND_MAIL("AweSun向日葵", body, logDir .. "\awsun_copied.png") === true;
}

MK_DISCONNECT();
STOP_REC();

console.log("");
console.log("================ 安装结果汇总 ================");
console.log("网易UU远程 安装并登录:", loginOk ? "成功" : "失败");
console.log("UU 识别码复制:", uuClip ? "成功" : "失败");
console.log("UU 邮件上报:", uuMailOk ? "成功" : "失败");
console.log("AweSun向日葵 安装并登录:", awLoginOk ? "成功" : "失败");
console.log("AweSun 识别码/验证码复制:", (awId && awCode) ? "成功" : "失败");
console.log("AweSun 邮件上报:", awMailOk ? "成功" : "失败");
console.log("火绒安全: 按要求跳过（不安装）");
console.log("日志目录:", logDir);
console.log("=================================================");
sleep(3000);
